FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fsiProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluidSolidInterface    fixedRelaxation;

fixedRelaxationCoeffs
{
    // Solid interface patch
    solidPatch             innerWall;

    // Fluid interface patch
    fluidPatch             innerWall;

    // Interface relaxation factor
    // Note: it is often fine to keep this at 1.0 when using the Robin condition
    // for 0/fluid/p, where the Robin acceleration can be controlled via the
    // `constantHs` parameter there
    relaxationFactor       1.0;

    // FSI outer loop tolerance
    outerCorrTolerance     5e-5;

    // Maximum FSI correctors per time step
    nOuterCorr             30;

    // Write FSI residuals to file
    writeResidualsToFile   yes;

    // Reference scales for the Robin convergence checks. The Robin pressure
    // and leakage residuals are relative to the largest interface pressure
    // and flux seen so far; before the inflow starts (t < 0.004 s) both are
    // round-off noise, so without a floor the relative residual never drops
    // below its tolerance and the coupling aborts. The fluid pressure is
    // kinematic (p/rho): 0.1 m2/s2 is about 105 Pa (0.8 mmHg)
    robinPressureReference     0.1;
    robinFluxReferenceVelocity 0.01;    // m/s
}


