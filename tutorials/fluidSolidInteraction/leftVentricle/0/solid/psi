FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      psi;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Apicobasal coordinate: 1 at base (inlet/outlet), 0 at apex.
// Solved by setFibreField via Laplace.

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    innerWall
    {
        type            zeroGradient;
    }
    outerWall
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 1;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 1;
    }
}

